{
  "name": "astro-portfolio-template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sync:images": "bash scripts/sync-images.sh",
    "gen:thumbs": "node scripts/gen-thumbs.mjs",
    "gen:manifest": "node scripts/build-manifest.mjs",
    "prep": "npm run sync:images && npm run gen:thumbs && npm run gen:manifest",
    "dev": "npm run prep && astro dev",
    "build": "npm run prep && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.7",
    "exifr": "^7.1.3",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.4.2",
    "sharp": "^0.35.1"
  }
}
