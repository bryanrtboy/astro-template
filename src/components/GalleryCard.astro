---
import type { GalleryItem } from '../lib/types';
import GalleryImage from './GalleryImage.astro';

// Accept optional `priority` for LCP (pass true for the first couple images if desired)
const { item, index, priority = false, useLightbox = true, linkToAnchor = false, variant = 'masonry' } = Astro.props as {
    item: GalleryItem;
    index: number;
    priority?: boolean;
    useLightbox?: boolean;
    linkToAnchor?: boolean;
    variant?: 'masonry' | 'uniform';
};

const stemSafe = item.stem;
const anchor   = `/${item.section}#${stemSafe}`;

// If no lightbox, link to the section page + anchor
const anchorHref = `/${item.section}#${stemSafe}`;
const versionSuffix = item.thumbVersion ? `?v=${encodeURIComponent(String(item.thumbVersion))}` : '';
const originalHref = item.base ? `/images/${item.section}/${item.base}${versionSuffix}` : anchorHref;
const hrefTarget = linkToAnchor ? anchor : (useLightbox ? originalHref : anchorHref);


const initialSpan = Math.max(1, item.rows ?? 1); // fallback if rows missing

const ar = item.ar ?? null; // height/width from manifest
---
<a
        id={stemSafe}
        class="card"
        style={`grid-row-end: span ${initialSpan}; --ar:${item.ar ?? 0.75};`}
        data-index={index}
        data-ar={ar ?? ''}
        href={hrefTarget}
        rel="noopener"
        data-year={item.year ?? ''}
        data-sale={item.sale ?? 'PRIVATE'}
        data-section={item.section}
        data-stem={stemSafe}
        data-thumb-version={item.thumbVersion ?? ''}
>
    <GalleryImage item={item} priority={priority} variant={variant} />

    <div class="overlay" aria-hidden="true">
        <div>
            <div class="title">{item.title}</div>
            {item.year ? <div class="sub">{item.year}</div> : null}
        </div>
    </div>
</a>
