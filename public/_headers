# For Astro's static JS/CSS (hashed filenames)
 /assets/*
  Cache-Control: public, max-age=31536000, immutable

# For full-size images
 /images/*
  Cache-Control: public, max-age=31536000, immutable

# For thumbnails
 /thumbs/*
  Cache-Control: public, max-age=31536000, immutable

# For generated JSON indexes
 /details/*
  Cache-Control: public, max-age=3600, must-revalidate

 /search-index.json
  Cache-Control: public, max-age=3600, must-revalidate

# to silence a Lighthouse complaint
/animation
  Content-Type: text/html; charset=utf-8

/animation/
  Content-Type: text/html; charset=utf-8
